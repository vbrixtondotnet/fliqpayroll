@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = null;
    var forced = ViewData["Forced"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password - FliqPayroll</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-stack">
        <img src="~/images/flig-logo-h-white.png" alt="FliqPayroll" class="login-logo-light" asp-append-version="true" />
        <div class="login-card card shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h1 class="h4 mb-0">Change your password</h1>
            </div>

            @if (forced)
            {
                <div class="alert alert-warning small" role="alert">
                    For your security, you must set a new password before you can continue.
                </div>
            }

            <form asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <div class="form-text">At least 6 characters, with an uppercase letter, a lowercase letter and a number.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Change password</button>
            </form>

            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3 text-center">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link btn-sm text-muted">Sign out</button>
            </form>
        </div>
        </div>
    </div>
</body>
</html>
