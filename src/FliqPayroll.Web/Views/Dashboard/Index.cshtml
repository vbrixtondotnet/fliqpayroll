@using FliqPayroll.Core.Constants
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Overview of employees, attendance, and payroll.</p>
</div>


<div class="row g-3" id="dashboard-cards">
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Total Employees</div>
                <div class="summary-value" id="total-employees">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Active</div>
                <div class="summary-value" id="active-employees">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Present Today</div>
                <div class="summary-value text-success" id="present-today">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Absent Today</div>
                <div class="summary-value text-danger" id="absent-today">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Monthly Payroll</div>
                <div class="summary-value" id="monthly-payroll">—</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="summary-label">Pending Payroll</div>
                <div class="summary-value text-warning" id="pending-payroll">—</div>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole(RoleConstants.FinanceOfficer))
{
    <div class="row g-3 mt-1" id="dashboard-approvals-section">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-white">
                    <div>
                        <span class="fw-semibold">Pending for Approval</span>
                        <span id="dashboard-approvals-count" class="badge bg-warning text-dark ms-2 d-none"></span>
                    </div>
                    <a asp-controller="Approvals" asp-action="Index" class="btn btn-sm btn-outline-primary">Open approvals</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Payroll Period</th>
                                    <th class="text-center">Employees</th>
                                    <th class="text-center">Fields Changed</th>
                                    <th>Submitted By</th>
                                    <th>Last Edit</th>
                                    <th style="width: 120px;"></th>
                                </tr>
                            </thead>
                            <tbody id="dashboard-approvals-body">
                                <tr><td colspan="6" class="text-center text-muted py-3">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
