@{
    ViewData["Title"] = "Shifts";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Shifts</h1>
    <p class="text-muted mb-0">Manage the Day and Night shift schedules and assign employees to each shift.</p>
</div>


<div class="card">
    <div class="card-header pb-0">
        <ul class="nav nav-tabs card-header-tabs" id="shift-tabs" role="tablist"></ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="shift-tab-content">
            <div class="text-muted">Loading shifts...</div>
        </div>
    </div>
</div>

<div class="modal fade" id="shift-edit-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Shift</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="shift-edit-id" />
                <div class="mb-3">
                    <label for="shift-edit-name" class="form-label">Shift Name</label>
                    <input type="text" class="form-control" id="shift-edit-name" maxlength="50" />
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label for="shift-edit-start" class="form-label">Start Time</label>
                        <input type="time" class="form-control" id="shift-edit-start" />
                    </div>
                    <div class="col-6">
                        <label for="shift-edit-end" class="form-label">End Time</label>
                        <input type="time" class="form-control" id="shift-edit-end" />
                    </div>
                </div>
                <div class="form-text mt-2">An end time earlier than the start time means the shift ends the next day.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="shift-edit-save">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shift-assign-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shift-assign-title">Assign Employees</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="shift-assign-id" />
                <input type="search" class="form-control mb-2" id="shift-assign-search" placeholder="Search by name, code or department" />
                <div class="form-text mb-2">Selecting an employee who is on another shift moves them to this shift.</div>
                <div class="list-group" id="shift-assign-list"></div>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="text-muted small" id="shift-assign-count"></span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="shift-assign-save">Save Assignments</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/shifts.js" asp-append-version="true"></script>
}
