@inject Microsoft.AspNetCore.Identity.UserManager<FliqPayroll.Data.Entities.ApplicationUser> UserManager
@{

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Avatar shown in the header: initials of the user's full name (first + last word), e.g. "Jen Degoma" -> "JD".
    var displayName = User.Identity?.Name ?? "";
    var initials = "?";
    if (User.Identity?.IsAuthenticated == true)
    {
        var fullName = (await UserManager.GetUserAsync(User))?.FullName?.Trim();
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            displayName = fullName;
            var words = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            initials = words.Length == 1
                ? words[0][..1].ToUpperInvariant()
                : (words[0][..1] + words[^1][..1]).ToUpperInvariant();
        }
        else if (displayName.Length > 0)
        {
            initials = displayName[..1].ToUpperInvariant();
        }
    }

}



<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - FliqPayroll</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/FliqPayroll.Web.styles.css" asp-append-version="true" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg app-navbar shadow-sm">

            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">

                    <img src="~/images/flig-logo-h-white.png" alt="FliqPayroll" class="navbar-brand-logo" asp-append-version="true" />

                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"

                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"

                               asp-controller="Dashboard" asp-action="Index">Dashboard</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Attendance" ? "active" : "")"

                               asp-controller="Attendance" asp-action="Index">Attendance</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Employees" ? "active" : "")"

                               asp-controller="Employees" asp-action="Index">Employees</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "PayrollV2" ? "active" : "")"

                               asp-controller="PayrollV2" asp-action="Index">Payroll</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Payslips" ? "active" : "")"

                               asp-controller="Payslips" asp-action="Index">Payslips</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Leaves" ? "active" : "")"

                               asp-controller="Leaves" asp-action="Index">Leaves</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "HolidayCalendar" ? "active" : "")"

                               asp-controller="HolidayCalendar" asp-action="Index">Holiday Calendar</a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link @(currentController == "Shifts" ? "active" : "")"

                               asp-controller="Shifts" asp-action="Index">Shifts</a>

                        </li>

                        @if (User.IsInRole(FliqPayroll.Core.Constants.RoleConstants.FinanceOfficer))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Approvals" ? "active" : "")"
                                   asp-controller="Approvals" asp-action="Index">Approvals</a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav mb-2 mb-lg-0">

                        @if (User.Identity?.IsAuthenticated == true)

                        {

                            @if (User.IsInRole(FliqPayroll.Core.Constants.RoleConstants.FinanceOfficer))
                            {
                                <li class="nav-item dropdown me-2" id="notification-bell">
                                    <button type="button" class="btn btn-link nav-link position-relative px-2 notification-bell-btn"
                                            id="notification-bell-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                            aria-expanded="false" aria-label="Notifications">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zm.995-14.901a1 1 0 1 0-1.99 0A5.002 5.002 0 0 0 3 6c0 1.098-.5 6-2 7h14c-1.5-1-2-5.902-2-7 0-2.42-1.72-4.44-4.005-4.901z" />
                                        </svg>
                                        <span id="notification-badge"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"></span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end notification-menu p-0" aria-labelledby="notification-bell-btn">
                                        <div class="notification-header px-3 py-2">
                                            <div class="fw-semibold">Pending approvals</div>
                                            <div id="notification-subtitle" class="small text-muted"></div>
                                        </div>
                                        <div id="notification-list" class="notification-list"></div>
                                        <a class="dropdown-item text-center small py-2 notification-footer" href="/Approvals">View all approvals</a>
                                    </div>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <button type="button" class="user-avatar-btn" id="user-menu-btn" data-bs-toggle="dropdown"
                                        aria-expanded="false" aria-label="Account menu for @displayName" title="@displayName">
                                    <span class="user-avatar" aria-hidden="true">@initials</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end user-menu" aria-labelledby="user-menu-btn">
                                    <li class="user-menu-header px-3 py-2">
                                        <div class="fw-semibold">@displayName</div>
                                        <div class="small text-muted">@User.Identity.Name</div>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>

                        }

                        else

                        {

                            <li class="nav-item">

                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <div class="container-fluid app-content">

        <main role="main">

            @RenderBody()

        </main>

    </div>



    <footer class="app-footer">

        <div class="container-fluid">

            &copy; @PhilippineTime.Now.Year - FliqPayroll

        </div>

    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/ph-time.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.IsInRole(FliqPayroll.Core.Constants.RoleConstants.FinanceOfficer))
    {
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

