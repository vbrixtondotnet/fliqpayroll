@{
    ViewData["Title"] = "Approvals";
}

<div class="page-header mb-4">
    <h1 class="h3 mb-1">Approvals</h1>
    <p class="text-muted mb-0">Payroll periods with manual changes waiting for your approval.</p>
</div>

<div id="approvals-alert" class="alert alert-danger d-none" role="alert"></div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Payroll Period</th>
                        <th class="text-center">Employees</th>
                        <th class="text-center">Fields Changed</th>
                        <th>Submitted By</th>
                        <th>Last Edit</th>
                        <th style="width: 140px;"></th>
                    </tr>
                </thead>
                <tbody id="approvals-list-body" data-page="list">
                    <tr><td colspan="6" class="text-center text-muted py-4">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/approvals.js" asp-append-version="true"></script>
}
