@{
    ViewData["Title"] = "Approvals";
    var periodId = (int)ViewData["PeriodId"]!;
    var periodName = (string)ViewData["PeriodName"]!;
}

<div class="page-header mb-4 d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none small">&larr; All approvals</a>
        <h1 class="h3 mb-1 mt-1">Approve Payroll Changes</h1>
        <p class="text-muted mb-0">Payroll period: <strong class="text-body">@periodName</strong></p>
    </div>
</div>


<div id="approval-detail" data-page="detail" data-period-id="@periodId">
    <div class="card mb-3" id="approval-bulk-card">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-7">
                    <label for="approval-note" class="form-label mb-1">Note <span class="text-muted">(optional, saved with your decision)</span></label>
                    <textarea id="approval-note" class="form-control" rows="2" maxlength="1000"
                              placeholder="Reason for approving or rejecting"></textarea>
                </div>
                <div class="col-lg-5 d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" id="approve-all-btn" class="btn btn-success">Approve all</button>
                    <button type="button" id="reject-all-btn" class="btn btn-outline-danger">Reject all</button>
                </div>
            </div>
            <p id="approval-summary" class="text-muted small mb-0 mt-3"></p>
        </div>
    </div>

    <div id="approval-requests">
        <div class="text-center text-muted py-4">Loading...</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/approvals.js" asp-append-version="true"></script>
}
